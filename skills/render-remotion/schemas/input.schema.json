{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opc://skills/render-remotion/input.schema.json",
  "title": "render-remotion input (= generate-script output.data)",
  "description": "可直接是本对象，或是包在 step-envelope 的 data 里（上一步 output.json 原样拷贝过来）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "themeId", "template", "storyboard", "metadataDraft", "targetPlatforms", "sourceRef"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "themeId": { "type": "string", "pattern": "^theme_[A-Za-z0-9_]+$" },
    "template": { "enum": ["remotion/explainer-30s"] },
    "storyboard": { "$ref": "storyboard.schema.json" },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string" },
        "storyboardPath": { "type": "string" }
      }
    },
    "metadataDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "tags"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 2000 },
        "tags": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 20 } },
        "category": { "type": "string" }
      }
    },
    "targetPlatforms": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["bilibili", "youtube", "douyin", "tiktok"] }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["themesFile", "themeId"],
      "properties": {
        "themesFile": { "type": "string" },
        "themeId": { "type": "string" }
      }
    }
  }
}
