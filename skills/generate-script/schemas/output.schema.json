{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opc://skills/generate-script/output.schema.json",
  "title": "generate-script output (= render-remotion input)",
  "description": "与 skills/render-remotion/schemas/input.schema.json 同构，内联 storyboard 定义以便被调度器单独校验。两处改动必须同步，测试见 test/schema-parity.test.mjs。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "themeId", "template", "storyboard", "metadataDraft", "targetPlatforms", "sourceRef"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "themeId": { "type": "string", "pattern": "^theme_[A-Za-z0-9_]+$" },
    "template": { "enum": ["remotion/explainer-30s"] },
    "storyboard": { "$ref": "#/$defs/storyboard" },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string" },
        "storyboardPath": { "type": "string" }
      }
    },
    "metadataDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "tags"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 2000 },
        "tags": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 20 } },
        "category": { "type": "string" }
      }
    },
    "targetPlatforms": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["bilibili", "youtube", "douyin", "tiktok"] }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["themesFile", "themeId"],
      "properties": {
        "themesFile": { "type": "string" },
        "themeId": { "type": "string" }
      }
    }
  },
  "$defs": {
    "storyboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme", "scenes"],
      "properties": {
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary", "background", "text"],
          "properties": {
            "primary": { "$ref": "#/$defs/color" },
            "background": { "$ref": "#/$defs/color" },
            "text": { "$ref": "#/$defs/color" }
          }
        },
        "scenes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "heading", "durationSec"],
            "properties": {
              "kind": { "enum": ["title", "point", "outro"] },
              "heading": { "type": "string", "minLength": 1, "maxLength": 24 },
              "body": { "type": "string", "maxLength": 60 },
              "durationSec": { "type": "number", "minimum": 2, "maximum": 20 }
            }
          }
        }
      }
    },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
  }
}
