{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opc://skills/generate-script/draft.schema.json",
  "title": "generate-script draft (由 pi 撰写，脚本只做校验与组装)",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "tags", "palette", "scriptMarkdown", "scenes"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 2000 },
    "tags": {
      "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 20 }
    },
    "palette": { "enum": ["midnight", "paper", "mint", "sunset"] },
    "scriptMarkdown": { "type": "string", "minLength": 20, "description": "口播脚本，Markdown" },
    "scenes": {
      "type": "array", "minItems": 2, "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "heading", "durationSec"],
        "properties": {
          "kind": { "enum": ["title", "point", "outro"] },
          "heading": { "type": "string", "minLength": 1, "maxLength": 24 },
          "body": { "type": "string", "maxLength": 60 },
          "durationSec": { "type": "number", "minimum": 2, "maximum": 20 }
        }
      }
    }
  }
}
